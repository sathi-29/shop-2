# ---- Brain (pick one; Gemini is what the original Jarvis uses) ----
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Or any OpenAI-compatible API (OpenAI, Groq, OpenRouter, Ollama, LM Studio...)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# With no key at all the assistant falls back to a simple keyword brain (demo only).

# Alternate: send every turn to the Python agent (this disables Jarvis shop tools).
# LLM_PROVIDER=voice_agent
# VOICE_AGENT_URL=http://127.0.0.1:8788
# VOICE_AGENT_TOKEN=
# Recommended ShopSphere integration: run `npm run dev:ai` from frontend instead.

# ---- Server ----
PORT=8787
APP_NAME=ShopApp
# Origin of your website (CORS). Use * only for local development.
ALLOWED_ORIGIN=*
# mock = built-in sample catalogue/orders, custom = server/adapter/custom.js (your real data)
ADAPTER=mock
