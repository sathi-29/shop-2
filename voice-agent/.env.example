# Copy to .env and fill in. Never commit .env.

# ---- Brain ----
# auto (default) uses Anthropic when ANTHROPIC_API_KEY is set, else OpenAI, else the offline stub.
VOICE_AGENT_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, Ollama, LM Studio...)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---- Sandbox and audit ----
# The only folder the file tools may read or write.
VOICE_AGENT_SANDBOX=.voice-agent-sandbox
VOICE_AGENT_AUDIT=

# name=executable, one per line. Defaults: notepad, text_editor, calculator, paint, files
# VOICE_AGENT_APP_ALLOWLIST=notepad=notepad.exe

# ---- Server ----
VOICE_AGENT_HOST=127.0.0.1
VOICE_AGENT_PORT=8788
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
VOICE_AGENT_TOKEN=

# ---- Behaviour ----
VOICE_AGENT_COMMAND_CONFIDENCE=0.7
VOICE_AGENT_TIMEOUT=30